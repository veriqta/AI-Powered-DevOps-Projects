{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veriqta.example/schemas/ai-finding.schema.json",
  "title": "Evidence-bound AI finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "summary",
    "severity",
    "confidence",
    "evidence_refs",
    "limitations"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^E-[0-9]{3,}$"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}

